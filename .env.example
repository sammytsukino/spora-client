# =============================================================================
# SPORA CLIENT — ENVIRONMENT TEMPLATE
# =============================================================================
#
# 1. Copy this file to `.env` in the spora-client root.
# 2. Restart `npm run dev` after any change (Vite only reads .env on startup).
# 3. Only variables prefixed with VITE_ are exposed to the browser.
#
# ⚠️  This file is the BRIDGE to spora-server. Without the correct API URL,
#     the SPA loads but login, floras, Laboratory, and profiles will not work.
#
# Full backend guide (Mongo, JWT, CORS, Cloudinary, SMTP):
#   ../spora-server/.env.example  and  ../spora-server/README.md
# =============================================================================


# -----------------------------------------------------------------------------
# VITE_API_BASE_URL — BACKEND BASE URL (REQUIRED)
# -----------------------------------------------------------------------------
# Where to get it:
#   • Local: http://localhost:4000/api  (spora-server port, must end with /api)
#   • Production: public Render or other host URL + /api
#     Example: https://spora-api.onrender.com/api
#
# Why it is CRITICAL:
#   All Axios calls (auth, floras, admin, contact, follows) use this base.
#   Wrong value → network errors, CORS failures, no session, empty Garden.
#
# Must align with server CORS_ORIGIN: the client URL (without /api) must be
# allowed in the backend .env.
#
VITE_API_BASE_URL=http://localhost:4000/api

# Production (uncomment and replace):
# VITE_API_BASE_URL=https://your-api.onrender.com/api
